<?xml version="1.0" encoding="UTF-8"?>
<robot name="lekiwi">
    <!-- Planning Groups -->
    <!-- 5-DoF manipulator chain: from base_footprint to gripperframe -->
    <group name="arm">
        <chain base_link="base_footprint" tip_link="gripperframe"/>
    </group>

    <!-- 1-DoF Gripper group -->
    <group name="gripper">
        <joint name="arm_gripper"/>
    </group>

    <!-- Group States (Named Poses) for 5-DoF arm -->
    <group_state name="home" group="arm">
        <joint name="arm_shoulder_pan" value="0.0"/>
        <joint name="arm_shoulder_lift" value="-1.57"/>
        <joint name="arm_elbow_flex" value="1.57"/>
        <joint name="arm_wrist_flex" value="0.0"/>
        <joint name="arm_wrist_roll" value="0.0"/>
    </group_state>

    <group_state name="stow" group="arm">
        <joint name="arm_shoulder_pan" value="0.0"/>
        <joint name="arm_shoulder_lift" value="-1.57"/>
        <joint name="arm_elbow_flex" value="1.57"/>
        <joint name="arm_wrist_flex" value="0.75"/>
        <joint name="arm_wrist_roll" value="0.0"/>
    </group_state>

    <group_state name="zero" group="arm">
        <joint name="arm_shoulder_pan" value="0.0"/>
        <joint name="arm_shoulder_lift" value="0.0"/>
        <joint name="arm_elbow_flex" value="0.0"/>
        <joint name="arm_wrist_flex" value="0.0"/>
        <joint name="arm_wrist_roll" value="0.0"/>
    </group_state>

    <group_state name="extended" group="arm">
        <joint name="arm_shoulder_pan" value="0.0"/>
        <joint name="arm_shoulder_lift" value="1.57"/>
        <joint name="arm_elbow_flex" value="-1.57"/>
        <joint name="arm_wrist_flex" value="0.0"/>
        <joint name="arm_wrist_roll" value="0.0"/>
    </group_state>

    <group_state name="open" group="gripper">
        <joint name="arm_gripper" value="1.5"/>
    </group_state>

    <group_state name="closed" group="gripper">
        <joint name="arm_gripper" value="-0.08"/>
    </group_state>

    <!-- End Effector -->
    <end_effector name="arm_ee" parent_link="gripperframe" group="gripper" parent_group="arm"/>

    <!-- Virtual Joint -->
    <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_footprint"/>

    <!-- Disable Collisions -->
    <disable_collisions link1="base_footprint" link2="rotation_pitch" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="omniwheel_7" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="omniwheel_8" reason="Adjacent"/>
    <disable_collisions link1="base_footprint" link2="omniwheel_9" reason="Adjacent"/>
    <disable_collisions link1="rotation_pitch" link2="upper_arm" reason="Adjacent"/>
    <disable_collisions link1="upper_arm" link2="lower_arm" reason="Adjacent"/>
    <disable_collisions link1="lower_arm" link2="wrist" reason="Adjacent"/>
    <disable_collisions link1="wrist" link2="gripper" reason="Adjacent"/>
    <disable_collisions link1="gripper" link2="moving_jaw_so101_v1" reason="Adjacent"/>
    <disable_collisions link1="lower_arm" link2="moving_jaw_so101_v1" reason="Never"/>
    <disable_collisions link1="wrist" link2="moving_jaw_so101_v1" reason="Never"/>
    <disable_collisions link1="base_footprint" link2="upper_arm" reason="Never"/>
    <disable_collisions link1="omniwheel_7" link2="omniwheel_8" reason="Never"/>
    <disable_collisions link1="omniwheel_7" link2="omniwheel_9" reason="Never"/>
    <disable_collisions link1="omniwheel_8" link2="omniwheel_9" reason="Never"/>
    <disable_collisions link1="rotation_pitch" link2="omniwheel_7" reason="Never"/>
    <disable_collisions link1="rotation_pitch" link2="omniwheel_8" reason="Never"/>
    <disable_collisions link1="rotation_pitch" link2="omniwheel_9" reason="Never"/>
</robot>

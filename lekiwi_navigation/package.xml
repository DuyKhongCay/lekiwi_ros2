<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_navigation</name>
  <version>0.1.0</version>
  <description>Navigation and costmap configurations for LeKiwi mobile base around chessboard arena</description>
  <maintainer email="duykhongcay@lekiwi.labs">DuyKhongCay</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>lekiwi_tag_localization</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<!--
  LeKiwi Arm Joints Description (Xacro)
  Single Source of Truth (SSOT) kinematic joint definitions for the LeKiwi 6-DOF arm.
  Dynamically binds joint limits (lower, upper) from the calibrated servo JSON profile
  using the Feetech STS3215 encoder tick conversion formula:
    rad = (tick - 2048) * 2.0 * pi / 4096.0
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="lekiwi_arm_joints" params="servo_calib_file:='$(find lekiwi_description)/config/calibration/DuyKhongCay.json'">
    <xacro:property name="jcfg" value="${xacro.load_yaml(servo_calib_file)}"/>

    <!-- Joint 1: arm_shoulder_pan -->
    <xacro:property name="pan_lower" value="${(jcfg['arm_shoulder_pan']['range_min'] - 2048) * 2.0 * pi / 4096.0}"/>
    <xacro:property name="pan_upper" value="${(jcfg['arm_shoulder_pan']['range_max'] - 2048) * 2.0 * pi / 4096.0}"/>
    <joint name="arm_shoulder_pan" type="revolute">
      <origin xyz="0.067148 -5e-07 0.1672" rpy="3.14159 0 3.13774"/>
      <parent link="base_footprint"/>
      <child link="rotation_pitch"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="${pan_lower}" upper="${pan_upper}"/>
    </joint>

    <!-- Joint 2: arm_shoulder_lift -->
    <xacro:property name="lift_lower" value="${(jcfg['arm_shoulder_lift']['range_min'] - 2048) * 2.0 * pi / 4096.0}"/>
    <xacro:property name="lift_upper" value="${(jcfg['arm_shoulder_lift']['range_max'] - 2048) * 2.0 * pi / 4096.0}"/>
    <joint name="arm_shoulder_lift" type="revolute">
      <origin xyz="-0.0306 -0.0183 -0.0542" rpy="-1.5708 -1.5708 0"/>
      <parent link="rotation_pitch"/>
      <child link="upper_arm"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="${lift_lower}" upper="${lift_upper}"/>
    </joint>

    <!-- Joint 3: arm_elbow_flex -->
    <xacro:property name="elbow_lower" value="${(jcfg['arm_elbow_flex']['range_min'] - 2048) * 2.0 * pi / 4096.0}"/>
    <xacro:property name="elbow_upper" value="${(jcfg['arm_elbow_flex']['range_max'] - 2048) * 2.0 * pi / 4096.0}"/>
    <joint name="arm_elbow_flex" type="revolute">
      <origin xyz="-0.11257 -0.028 0" rpy="-0 -0 1.57038"/>
      <parent link="upper_arm"/>
      <child link="lower_arm"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="${elbow_lower}" upper="${elbow_upper}"/>
    </joint>

    <!-- Joint 4: arm_wrist_flex -->
    <xacro:property name="wrist_flex_lower" value="${(jcfg['arm_wrist_flex']['range_min'] - 2048) * 2.0 * pi / 4096.0}"/>
    <xacro:property name="wrist_flex_upper" value="${(jcfg['arm_wrist_flex']['range_max'] - 2048) * 2.0 * pi / 4096.0}"/>
    <joint name="arm_wrist_flex" type="revolute">
      <origin xyz="-0.1349 0.0052 -0" rpy="-0 0 -1.57999"/>
      <parent link="lower_arm"/>
      <child link="wrist"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="${wrist_flex_lower}" upper="${wrist_flex_upper}"/>
    </joint>

    <!-- Joint 5: arm_wrist_roll -->
    <xacro:property name="wrist_roll_lower" value="${(jcfg['arm_wrist_roll']['range_min'] - 2048) * 2.0 * pi / 4096.0}"/>
    <xacro:property name="wrist_roll_upper" value="${(jcfg['arm_wrist_roll']['range_max'] - 2048) * 2.0 * pi / 4096.0}"/>
    <joint name="arm_wrist_roll" type="revolute">
      <origin xyz="-5.18e-10 -0.0611 0.0181" rpy="1.5708 0.0594906 3.14159"/>
      <parent link="wrist"/>
      <child link="gripper"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="${wrist_roll_lower}" upper="${wrist_roll_upper}"/>
    </joint>

    <!-- Joint 6: arm_gripper -->
    <xacro:property name="gripper_lower" value="${(jcfg['arm_gripper']['range_min'] - 2048) * 2.0 * pi / 4096.0}"/>
    <xacro:property name="gripper_upper" value="${(jcfg['arm_gripper']['range_max'] - 2048) * 2.0 * pi / 4096.0}"/>
    <joint name="arm_gripper" type="revolute">
      <origin xyz="0.0202 0.0186 -0.0234" rpy="1.5708 0.000965842 -0"/>
      <parent link="gripper"/>
      <child link="moving_jaw_so101_v1"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="${gripper_lower}" upper="${gripper_upper}"/>
    </joint>
  </xacro:macro>
</robot>


<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_episode_recorder</name>
  <version>0.1.0</version>
  <description>ROS 2 Episode Recorder for LeKiwi Imitation Learning (LeRobot 3.0), featuring Gamepad D-Pad workflow and MCAP storage.</description>
  <maintainer email="duykhongcay@todo.todo">duykhongcay</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 core & messages -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>

  <!-- Bag recording & MCAP -->
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <!-- Launch dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

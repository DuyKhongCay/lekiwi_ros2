<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Adds standard transmission metadata when a downstream consumer requires it. -->
  <xacro:macro name="simple_transmission" params="joint_name">
    <transmission name="${joint_name}_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <mechanicalReduction>1</mechanicalReduction>
      </joint>
      <actuator name="${joint_name}_actuator">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- Declares interfaces once so real and mock hardware expose the same contract. -->
  <xacro:macro name="lekiwi_control_joint" params="joint_name servo_id command_interface acceleration:='50' velocity_scale:='' velocity_direction:='1' max_velocity:='5.0'">
    <joint name="${joint_name}">
      <param name="id">${servo_id}</param>
      <param name="acceleration">${acceleration}</param>
      <xacro:if value="${command_interface == 'velocity'}">
        <param name="velocity_radians_per_second_per_tick">${velocity_scale}</param>
        <param name="velocity_direction">${velocity_direction}</param>
        <param name="max_velocity_radians_per_second">${max_velocity}</param>
      </xacro:if>
      <command_interface name="${command_interface}"/>
      <command_interface name="torque_enable"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Selects hardware at launch time while retaining a non-actuating mock default. -->
  <xacro:macro name="lekiwi_ros2_control" params="hardware_type usb_port">
    <ros2_control name="LeKiwiSystem" type="system">
      <hardware>
        <xacro:if value="${hardware_type == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${hardware_type == 'real'}">
          <plugin>lekiwi_ftservo_hardware/LeKiwiFeetechHardwareInterface</plugin>
          <param name="usb_port">${usb_port}</param>
        </xacro:if>
      </hardware>
      <xacro:lekiwi_control_joint joint_name="arm_shoulder_pan" servo_id="1" command_interface="position" acceleration="50"/>
      <xacro:lekiwi_control_joint joint_name="arm_shoulder_lift" servo_id="2" command_interface="position" acceleration="50"/>
      <xacro:lekiwi_control_joint joint_name="arm_elbow_flex" servo_id="3" command_interface="position" acceleration="50"/>
      <xacro:lekiwi_control_joint joint_name="arm_wrist_flex" servo_id="4" command_interface="position" acceleration="50"/>
      <xacro:lekiwi_control_joint joint_name="arm_wrist_roll" servo_id="5" command_interface="position" acceleration="50"/>
      <xacro:lekiwi_control_joint joint_name="arm_gripper" servo_id="6" command_interface="position" acceleration="50"/>
      <xacro:lekiwi_control_joint joint_name="base_left_wheel" servo_id="7" command_interface="velocity" acceleration="0" velocity_scale="0.0015339807878856412" velocity_direction="-1" max_velocity="5.0"/>
      <xacro:lekiwi_control_joint joint_name="base_back_wheel" servo_id="8" command_interface="velocity" acceleration="0" velocity_scale="0.0015339807878856412" velocity_direction="-1" max_velocity="5.0"/>
      <xacro:lekiwi_control_joint joint_name="base_right_wheel" servo_id="9" command_interface="velocity" acceleration="0" velocity_scale="0.0015339807878856412" velocity_direction="-1" max_velocity="5.0"/>
    </ros2_control>
  </xacro:macro>

  <!-- Declares IMU ros2_control sensor component with 13 state interfaces -->
  <xacro:macro name="lekiwi_imu_ros2_control" params="hardware_type:='mock' i2c_bus:=1 i2c_address:='0x68' auto_calibrate_gyro:='true' gyro_calib_samples:=500">
    <ros2_control name="LeKiwiImu" type="sensor" is_async="true">
      <properties>
        <async scheduling_policy="detached" print_warnings="false" thread_priority="30"/>
      </properties>
      <hardware>
        <plugin>lekiwi_icm20948_hardware/ICM20948SensorHardware</plugin>
        <param name="mock_sensor">${'true' if hardware_type == 'mock' else 'false'}</param>
        <param name="i2c_bus">${i2c_bus}</param>
        <param name="i2c_address">${i2c_address}</param>
        <param name="auto_calibrate_gyro">${auto_calibrate_gyro}</param>
        <param name="gyro_calib_samples">${gyro_calib_samples}</param>
      </hardware>
      <sensor name="icm20948_imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
        <state_interface name="magnetic_field.x"/>
        <state_interface name="magnetic_field.y"/>
        <state_interface name="magnetic_field.z"/>
        <param name="frame_id">icm20948_imu</param>
      </sensor>
    </ros2_control>
  </xacro:macro>
</robot>

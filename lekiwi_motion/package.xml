<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_motion</name>
  <version>0.2.0</version>
  <description>
    LeKiwi Motion Subsystem: Workspace reachability planning, chess move kinematics,
    TF readiness gatekeeper, and torque lifecycle management.
  </description>
  <maintainer email="duykhongcay@todo.todo">duykhongcay</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ dependencies: build + exec (dùng <depend>) -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>diagnostic_updater</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>rclcpp_components</depend>
  <depend>urdf</depend>
  <depend>eigen</depend>
  <depend>lekiwi_interfaces</depend>
  <depend>controller_manager_msgs</depend>

  <depend>diagnostic_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rcl_interfaces</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>kdl_parser</test_depend>
  <test_depend>orocos_kdl</test_depend>
  <test_depend>lekiwi_description</test_depend>
  <test_depend>xacro</test_depend>
  <test_depend>yaml-cpp</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>composition_interfaces</test_depend>
  <test_depend>rmw_fastrtps_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

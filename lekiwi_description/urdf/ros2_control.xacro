<?xml version="1.0"?>
<!--
  LeKiwi ros2_control Hardware Interface Macros
  Configures transmission metadata, joint command/state interfaces for STS3215 servos
  (arm position control, base wheel velocity control), and ICM20948 IMU sensor interfaces.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Adds standard transmission metadata when a downstream simulator requires it. -->
  <xacro:macro name="simple_transmission" params="joint_name">
    <transmission name="${joint_name}_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <mechanicalReduction>1</mechanicalReduction>
      </joint>
      <actuator name="${joint_name}_actuator">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- SO-ARM100 STS3215 Servo Control Profile Constants (Position Mode) -->
  <xacro:property name="arm_p_coefficient" value="16"/>
  <xacro:property name="arm_i_coefficient" value="0"/>
  <xacro:property name="arm_d_coefficient" value="32"/>
  <xacro:property name="arm_return_delay_time" value="0"/>

  <!-- 3-Wheel Omnidirectional Base Dynamics & Kinematics Constants (Velocity Mode) -->
  <xacro:property name="wheel_velocity_scale" value="0.0015339807878856412"/>
  <xacro:property name="wheel_velocity_direction" value="-1"/>
  <xacro:property name="wheel_max_velocity" value="5.0"/>

  <!-- Declares joint command/state interfaces and limits from calibration data matching the hardware contract. -->
  <xacro:macro name="lekiwi_control_joint" params="joint_name cfg command_interface acceleration:=''">
    <!-- Use override acceleration if provided (e.g. from arm_control_mode), otherwise default to 50 -->
    <xacro:property name="accel" value="${acceleration if acceleration != '' else '50'}"/>
    <joint name="${joint_name}">
      <param name="id">${cfg['id']}</param>
      <param name="acceleration">${accel}</param>

      <!-- Position Mode (Arm joints) -->
      <xacro:if value="${command_interface == 'position'}">
        <xacro:property name="min_pos" value="${(cfg['range_min'] - 2048) * 2.0 * pi / 4096.0}"/>
        <xacro:property name="max_pos" value="${(cfg['range_max'] - 2048) * 2.0 * pi / 4096.0}"/>
        <param name="range_min">${cfg['range_min']}</param>
        <param name="range_max">${cfg['range_max']}</param>
        <param name="homing_offset">${cfg['homing_offset']}</param>

        <!-- Hardware servo profile constants -->
        <param name="p_coefficient">${arm_p_coefficient}</param>
        <param name="i_coefficient">${arm_i_coefficient}</param>
        <param name="d_coefficient">${arm_d_coefficient}</param>
        <param name="return_delay_time">${arm_return_delay_time}</param>

        <command_interface name="position">
          <param name="min">${min_pos}</param>
          <param name="max">${max_pos}</param>
        </command_interface>
        <state_interface name="position">
          <param name="min">${min_pos}</param>
          <param name="max">${max_pos}</param>
        </state_interface>
      </xacro:if>

      <!-- Velocity Mode (Base omni wheels) -->
      <xacro:if value="${command_interface == 'velocity'}">
        <param name="velocity_radians_per_second_per_tick">${wheel_velocity_scale}</param>
        <param name="velocity_direction">${wheel_velocity_direction}</param>
        <param name="max_velocity_radians_per_second">${wheel_max_velocity}</param>

        <command_interface name="velocity">
          <param name="min">-${wheel_max_velocity}</param>
          <param name="max">${wheel_max_velocity}</param>
        </command_interface>
        <state_interface name="position"/>
      </xacro:if>

      <command_interface name="torque_enable"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Selects hardware at launch time while retaining a non-actuating mock default. -->
  <xacro:macro name="lekiwi_ros2_control" params="hardware_type usb_port arm_control_mode:='kinematics' servo_calib_file:='$(find lekiwi_description)/config/calibration/DuyKhongCay.json'">
    <!-- Load servo calibration dictionary (SSOT for IDs, tick limits, and homing offsets) -->
    <xacro:property name="jcfg" value="${xacro.load_yaml(servo_calib_file)}"/>

    <!--
      Resolve arm acceleration profile based on active control paradigm:
      - 'kinematics': accel=0 (Host QuinticTrajectoryPlanner handles C² profiling, avoids phase lag and path tolerance aborts)
      - 'policy': accel=50 (MCU hardware ramp filters high-frequency jitter from neural network policy predictions)
    -->
    <xacro:property name="arm_accel" value="${'50' if arm_control_mode == 'policy' else '0'}"/>
    <ros2_control name="LeKiwiSystem" type="system">
      <hardware>
        <xacro:if value="${hardware_type == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${hardware_type == 'real'}">
          <plugin>lekiwi_ftservo_hardware/LeKiwiFeetechHardwareInterface</plugin>
          <param name="usb_port">${usb_port}</param>
        </xacro:if>
      </hardware>

      <!-- Arm joints: dynamic limits computed from range_min / range_max -->
      <xacro:lekiwi_control_joint joint_name="arm_shoulder_pan"  cfg="${jcfg['arm_shoulder_pan']}"  command_interface="position" acceleration="${arm_accel}"/>
      <xacro:lekiwi_control_joint joint_name="arm_shoulder_lift" cfg="${jcfg['arm_shoulder_lift']}" command_interface="position" acceleration="${arm_accel}"/>
      <xacro:lekiwi_control_joint joint_name="arm_elbow_flex"    cfg="${jcfg['arm_elbow_flex']}"    command_interface="position" acceleration="${arm_accel}"/>
      <xacro:lekiwi_control_joint joint_name="arm_wrist_flex"    cfg="${jcfg['arm_wrist_flex']}"    command_interface="position" acceleration="${arm_accel}"/>
      <xacro:lekiwi_control_joint joint_name="arm_wrist_roll"    cfg="${jcfg['arm_wrist_roll']}"    command_interface="position" acceleration="${arm_accel}"/>
      <xacro:lekiwi_control_joint joint_name="arm_gripper"       cfg="${jcfg['arm_gripper']}"       command_interface="position" acceleration="${arm_accel}"/>

      <!-- Wheel joints: velocity limits & tick scaling configured from mechanical constants -->
      <xacro:lekiwi_control_joint joint_name="base_left_wheel"   cfg="${jcfg['base_left_wheel']}"   command_interface="velocity" acceleration="0"/>
      <xacro:lekiwi_control_joint joint_name="base_back_wheel"   cfg="${jcfg['base_back_wheel']}"   command_interface="velocity" acceleration="0"/>
      <xacro:lekiwi_control_joint joint_name="base_right_wheel"  cfg="${jcfg['base_right_wheel']}"  command_interface="velocity" acceleration="0"/>
    </ros2_control>
  </xacro:macro>

  <!-- Declares IMU ros2_control sensor component with 13 state interfaces -->
  <xacro:macro name="lekiwi_imu_ros2_control" params="hardware_type:='mock' i2c_bus:=1 i2c_address:='0x68' auto_calibrate_gyro:='true' gyro_calib_samples:=500">
    <ros2_control name="LeKiwiImu" type="sensor" is_async="true">
      <properties>
        <async scheduling_policy="detached" print_warnings="false" thread_priority="30"/>
      </properties>
      <hardware>
        <plugin>lekiwi_icm20948_hardware/ICM20948SensorHardware</plugin>
        <param name="mock_sensor">${'true' if hardware_type == 'mock' else 'false'}</param>
        <param name="i2c_bus">${i2c_bus}</param>
        <param name="i2c_address">${i2c_address}</param>
        <param name="auto_calibrate_gyro">${auto_calibrate_gyro}</param>
        <param name="gyro_calib_samples">${gyro_calib_samples}</param>
      </hardware>
      <sensor name="icm20948_imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
        <state_interface name="magnetic_field.x"/>
        <state_interface name="magnetic_field.y"/>
        <state_interface name="magnetic_field.z"/>
        <param name="frame_id">icm20948_imu</param>
      </sensor>
    </ros2_control>
  </xacro:macro>
</robot>

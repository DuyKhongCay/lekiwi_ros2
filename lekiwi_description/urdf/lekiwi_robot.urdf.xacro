<?xml version="1.0"?>
<!--
  LeKiwi Robot Top-Level Description (Xacro)
  Integrates CAD kinematic model (duykhongcay_lekiwi.urdf), ros2_control hardware
  interfaces (ros2_control.xacro), and sensor calibration transforms (sensors_calibration.xacro).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lekiwi">
  <!-- Core hardware control arguments -->
  <xacro:arg name="use_ros2_control" default="true"/>
  <xacro:arg name="hardware_type" default="mock"/>
  <xacro:arg name="usb_port" default="/dev/lekiwi_serial"/>
  <xacro:arg name="add_transmissions" default="false"/>
  <xacro:arg name="arm_control_mode" default="kinematics"/>

  <!-- IMU sensor hardware arguments -->
  <xacro:arg name="enable_imu" default="true"/>
  <xacro:arg name="imu_i2c_bus" default="1"/>
  <xacro:arg name="imu_i2c_address" default="0x68"/>
  <xacro:arg name="imu_auto_calibrate_gyro" default="true"/>
  <xacro:arg name="imu_gyro_calib_samples" default="500"/>

  <!-- Hand-eye camera extrinsics calibration file -->
  <xacro:arg name="camera_calib_file" default="$(find lekiwi_description)/config/calibration/handeye_calib_stereo_left.yaml"/>

  <!-- Feetech STS3215 bus servo calibration file -->
  <xacro:arg name="servo_calib_file" default="$(find lekiwi_description)/config/calibration/DuyKhongCay.json"/>

  <!-- Include kinematic CAD model and modular subsystems -->
  <xacro:include filename="$(find lekiwi_description)/urdf/duykhongcay_lekiwi.urdf"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/ros2_control.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/sensors_calibration.xacro"/>

  <!-- Apply hand-eye extrinsics calibration for stereo left camera -->
  <xacro:stereo_camera_calibration calib_file="$(arg camera_calib_file)"/>

  <!-- Instantiate ros2_control actuators and sensor hardware interfaces -->
  <xacro:if value="$(arg use_ros2_control)">
    <xacro:lekiwi_ros2_control hardware_type="$(arg hardware_type)" usb_port="$(arg usb_port)" arm_control_mode="$(arg arm_control_mode)" servo_calib_file="$(arg servo_calib_file)"/>
    <xacro:if value="$(arg enable_imu)">
      <xacro:lekiwi_imu_ros2_control hardware_type="$(arg hardware_type)" i2c_bus="$(arg imu_i2c_bus)" i2c_address="$(arg imu_i2c_address)" auto_calibrate_gyro="$(arg imu_auto_calibrate_gyro)" gyro_calib_samples="$(arg imu_gyro_calib_samples)"/>
    </xacro:if>
  </xacro:if>

  <!-- Optional simple transmission declarations for simulator backends -->
  <xacro:if value="$(arg add_transmissions)">
    <xacro:simple_transmission joint_name="arm_shoulder_pan"/>
    <xacro:simple_transmission joint_name="arm_shoulder_lift"/>
    <xacro:simple_transmission joint_name="arm_elbow_flex"/>
    <xacro:simple_transmission joint_name="arm_wrist_flex"/>
    <xacro:simple_transmission joint_name="arm_wrist_roll"/>
    <xacro:simple_transmission joint_name="arm_gripper"/>
    <xacro:simple_transmission joint_name="base_left_wheel"/>
    <xacro:simple_transmission joint_name="base_back_wheel"/>
    <xacro:simple_transmission joint_name="base_right_wheel"/>
  </xacro:if>
</robot>
